@{
    ViewData["Title"] = "Inicio";
}
<!-- Eslogan -->
<section class="hero">
    <h2>BOLSOS DE TELA HECHOS A MANO CON MIMO Y DETALLE</h2>
    <h2>EDICIONES LIMITADAS</h2>
</section>

<!-- Slider Section -->
<section id="slider" class="slider">
    <div class="slider-container">
        <div class="slide active">
            <img src="@Url.Content("~/Images/Lota_Grande_Azul.jpeg")" alt="Adjetivo 1" />
            <p class="adjetivo">Elegancia</p>
        </div>
        <div class="slide">
            <img src="@Url.Content("~/Images/Lota_Palmeras_Azules.jpeg")" alt="Adjetivo 2" />
            <p class="adjetivo">Sencillez</p>
        </div>
        <div class="slide">
            <img src="@Url.Content("~/Images/Doble_Lota_Liso.jpg")" alt="Adjetivo 3" />
            <p class="adjetivo">Amistad</p>
        </div>
        <div class="slide">
            <img src="@Url.Content("~/Images/Doble_Lota_Rayas.jpg")" alt="Adjetivo 4" />
            <p class="adjetivo">Comodidad</p>
        </div>
        <div class="slide">
            <img src="@Url.Content("~/Images/Lota_Grande_Rosa.jpeg")" alt="Adjetivo 5" />
            <p class="adjetivo">Artesanía</p>
        </div>
    </div>

    <button class="slider-button prev" onclick="moveSlide(-1)">&#10094;</button>
    <button class="slider-button next" onclick="moveSlide(1)">&#10095;</button>

</section>

