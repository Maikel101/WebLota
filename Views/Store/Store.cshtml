@model IEnumerable<WebLota.Models.Producto>


<section class="hero">
</section>


<section class="products container my-5">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var producto in Model)
        {
            <div class="col">
                <div class="card product-card text-center shadow-lg rounded-3">
                    <a href="@Url.Action("Details", "Productos", new { id = producto.Id })" class="text-decoration-none">
                        <!-- Imagen con borde redondeado y sombra sutil -->
                        <img src="@Url.Content("~/Images/" + producto.ImagenUrl)" class="card-img-top rounded-top" alt="@producto.Nombre">
                        <div class="card-body">
                            <!-- Título en mayúsculas y un color sutil -->
                            <h5 class="card-title text-uppercase font-weight-bold">@producto.Nombre</h5>
                            <!-- Precio destacado con un color suave y tamaño de fuente ajustado -->
                            <p class="card-text text-muted"> €@producto.Precio</p>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>
</section>



